# Server
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Africa/Cairo

# MongoDB
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=elsafeer_pos

# JWT
# استخدم قيمة عشوائية قوية بطول 32 حرفًا على الأقل، ولا ترفع ملف .env إلى Git.
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=12h

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
